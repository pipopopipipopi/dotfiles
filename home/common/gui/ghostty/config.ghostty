theme = oreore.conf

font-feature = -calt
font-feature = -liga
font-feature = -dlig

font-family = JetBrainsMono Nerd Font
font-family = HackGen Console NF
font-family = Twitter Color Emoji

background-opacity = 0.9

window-decoration = none
window-padding-x = 0
window-padding-y = 0

mouse-hide-while-typing = true
